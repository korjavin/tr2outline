# Service Configuration
PORT=3000

# Anarlog Webhook Secret(s) for HMAC-SHA256 verification.
# Supports a single secret or a comma-separated list of secrets (for multiple devices/clients):
# ANARLOG_WEBHOOK_SECRET=secret_phone,secret_laptop,secret_mac
ANARLOG_WEBHOOK_SECRET=your_anarlog_webhook_secret_here

# Outline Configuration
OUTLINE_URL=https://app.getoutline.com
OUTLINE_API_KEY=ol_api_your_token_here
OUTLINE_COLLECTION_ID=your-target-collection-uuid-here

# Optional: Reverse Proxy / Traefik Configuration (for docker-compose)
# DOMAIN=tr2o.kfamcloud.com
# TRAEFIK_NETWORK_NAME=vaultwarden_default
# TRAEFIK_CERTRESOLVER=letsencrypt
